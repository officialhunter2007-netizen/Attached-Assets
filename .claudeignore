# NOTE: Claude Code does NOT natively read .claudeignore.
# The authoritative block list lives in .claude/settings.json (permissions.deny).
# Claude Code also auto-respects .gitignore in search (ripgrep).
# This file is kept as human-readable documentation of what to skip.

# ── Build outputs (compiled, never read source here) ─────────────────
**/dist/
**/*.map
**/*.tsbuildinfo
/out/

# ── Dependencies ─────────────────────────────────────────────────────
**/node_modules/

# ── Lock files (huge, rarely needed) ─────────────────────────────────
pnpm-lock.yaml
**/package-lock.json

# ── Runtime caches / generated assets ────────────────────────────────
artifacts/api-server/data/      # teacher-image + v4-scene disk cache
.cache/

# ── Logs & temp ──────────────────────────────────────────────────────
**/*.log
tmp/

# ── Git internals (use `git` via bash instead of reading .git/) ──────
.git/

# ── Replit-only internals (irrelevant on your VPS) ───────────────────
.local/
.agents/

# ── IDE / OS noise ───────────────────────────────────────────────────
.vscode/
.idea/
**/.DS_Store

# ── KEPT INTENTIONALLY (do NOT ignore — real source you may edit) ────
# artifacts/nukhba-promo/src/   ← promo marketing site (real project)
# artifacts/mockup-sandbox/src/ ← component preview (real project)
# lib/*/src/                    ← shared package SOURCE (db schema lives here)
